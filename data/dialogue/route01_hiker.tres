[gd_resource type="Resource" script_class="DialogueData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
text = "The view from up here is great!"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
text = "On a clear day you can see all the way back to Fernhollow."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
text = "See the tent by the pond? Someone from the lab camps out there to study the wildlife."

[resource]
script = ExtResource("1_data")
speaker = "Hiker"
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2"), SubResource("Resource_line3")])

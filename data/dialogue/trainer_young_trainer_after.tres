[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
text = "You're getting stronger. Keep training!"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
text = "Tip: wear a wild creature down before you throw a Capture Orb. Healthy ones break free much more often."

[resource]
script = ExtResource("1_data")
speaker = "Young Trainer"
lines = Array[ExtResource("2_line")]([SubResource("Resource_line1"), SubResource("Resource_line2")])
